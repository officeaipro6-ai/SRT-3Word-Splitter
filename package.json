{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:clean": "npm run clean && npm run build",
    "start": "node -e \"process.env.NODE_ENV='production';require('./dist/server.cjs')\"",
    "serve": "npm run build:clean && npm start",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"server/**/*.test.ts\" \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "verify:routes": "tsx scripts/verifyUiRoutes.ts",
    "migrate:dry-run": "tsx scripts/migrate-to-production.ts --dry-run",
    "migrate:execute": "tsx scripts/migrate-to-production.ts --execute",
    "migrate:verify": "tsx scripts/migrate-to-production.ts --verify",
    "migrate:storage-dry-run": "tsx scripts/migrate-to-production.ts --storage-dry-run",
    "migrate:storage-verify": "tsx scripts/migrate-to-production.ts --storage-verify",
    "desktop:dev": "concurrently -k \"cross-env BUILD_TARGET=electron VITE_API_BASE_URL=https://srt-3word-splitter.onrender.com vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development tsx --import=tsx electron/main.ts\"",
    "desktop:build": "cross-env BUILD_TARGET=electron VITE_API_BASE_URL=https://srt-3word-splitter.onrender.com vite build && esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/electron/main.js",
    "desktop:dist": "npm run desktop:build && electron-builder --win --x64",
    "desktop:pack": "npm run desktop:build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.14.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "groq-sdk": "^1.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^10.0.15",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.odiasrt.desktop",
    "productName": "Odia SRT Desktop",
    "directories": {
      "output": "release",
      "buildResources": "buildResources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "portable": {
      "artifactName": "Odia-SRT-Desktop.exe"
    }
  }
}
