# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OLIVE_API_URL: Base URL of an Olive Odia ASR server (OdiaGenAI Whisper fine-tune).
# Used ONLY when TRANSCRIPTION_PROVIDER=olive. Point at a running Olive server:
#   - the public Hugging Face Space (e.g. https://odiagenai-olive-whisper-asr.hf.space)
#   - or a local instance (http://127.0.0.1:5000)
# The primary provider (Sarvam) is unaffected by this value.
OLIVE_API_URL="YOUR_OLIVE_API_URL_HERE"

# TRANSCRIPTION_PROVIDER: which engine to use for /api/process-audio.
#   sarvam (default) | groq | olive
TRANSCRIPTION_PROVIDER="sarvam"

# ASR_PROVIDER: canonical provider selector (used by the job queue API).
#   sarvam (default) | olive | groq | azure
# Azure is a configuration hook ONLY — no Azure code runs until integration is
# implemented and real AZURE_SPEECH_KEY/REGION values are provided. Leave unset
# to keep Sarvam as the active provider.
# ASR_PROVIDER="sarvam"

# Future Azure Speech credentials — DO NOT fill in fake values. Azure integration
# is not implemented yet; setting these alone does not activate anything.
# AZURE_SPEECH_KEY=""
# AZURE_SPEECH_REGION=""

# CREDITS (monetization prep; all credit logic is server-side and idempotent):
#   INITIAL_CREDITS=0        credits granted to each new user session
#   CREDITS_PER_JOB=1        credits charged per transcription job
# INITIAL_CREDITS="0"
# CREDITS_PER_JOB="1"

# JOB QUEUE (local durable queue; long audio is processed off the request path):
#   ENABLE_JOB_QUEUE=true
#   JOB_TIMEOUT_MS=900000            15 min max wall-clock per job
#   MAX_JOB_RETRIES=1                auto-retries for transient failures
#   PER_USER_ACTIVE_JOBS=3           simultaneous QUEUED+PROCESSING per user
#   MAX_UPLOAD_BYTES=104857600       100 MB hard cap
#   UPLOAD_RATE_LIMIT_MAX=10         uploads allowed per window
#   UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
# ENABLE_JOB_QUEUE="true"
# JOB_TIMEOUT_MS="900000"
# MAX_JOB_RETRIES="1"
# PER_USER_ACTIVE_JOBS="3"

# DATA_DIR: durable state (DB file + uploaded audio + SRTs). Gitignored.
# DATA_DIR="data"

# LOG_LEVEL: debug | info | warn | error (structured JSON lines)
# LOG_LEVEL="info"

# ADMIN_BOOTSTRAP_TOKEN: OPTIONAL operator-only secret (>= 16 chars). When a
# session is created with this value as `adminBootstrapToken`, that user is
# granted role=ADMIN + creditMode=UNLIMITED (persisted in the DB, server-side).
# The role is NEVER read from the browser. Create your admin session with it,
# then remove this line from .env.
# ADMIN_BOOTSTRAP_TOKEN="change-me-to-a-long-random-string"
