# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL OWNERSHIP VERIFICATION — delivery (REQUIRED for real verification emails):
#   RESEND_API_KEY   Resend HTTP API key (https://resend.com). Emails are sent over
#                    HTTPS port 443 via https://api.resend.com/emails — no SMTP.
#   EMAIL_FROM       verified sender, e.g. "Odia SRT <noreply@yourdomain.com>".
# When RESEND_API_KEY is unset the app falls back to printing the verification
# link in the server logs (development only); no real email is sent in that mode.
# The API key is never logged, never returned to a client and never committed.
# RESEND_API_KEY=""
# EMAIL_FROM=""

# OLIVE_API_URL: Base URL of an Olive Odia ASR server (OdiaGenAI Whisper fine-tune).
# Used ONLY when TRANSCRIPTION_PROVIDER=olive. Point at a running Olive server:
#   - the public Hugging Face Space (e.g. https://odiagenai-olive-whisper-asr.hf.space)
#   - or a local instance (http://127.0.0.1:5000)
# The primary provider (Sarvam) is unaffected by this value.
OLIVE_API_URL="YOUR_OLIVE_API_URL_HERE"

# TRANSCRIPTION_PROVIDER: which engine to use for /api/process-audio.
#   sarvam (default) | groq | olive
TRANSCRIPTION_PROVIDER="sarvam"

# ASR_PROVIDER: canonical provider selector (used by the job queue API).
#   sarvam (default) | olive | groq | azure
# Azure is a configuration hook ONLY — no Azure code runs until integration is
# implemented and real AZURE_SPEECH_KEY/REGION values are provided. Leave unset
# to keep Sarvam as the active provider.
# ASR_PROVIDER="sarvam"

# Future Azure Speech credentials — DO NOT fill in fake values. Azure integration
# is not implemented yet; setting these alone does not activate anything.
# AZURE_SPEECH_KEY=""
# AZURE_SPEECH_REGION=""

# CREDITS (monetization prep; all credit logic is server-side and idempotent):
#   INITIAL_CREDITS=0        credits granted to each new user session
#   CREDITS_PER_JOB=1        credits charged per transcription job
# INITIAL_CREDITS="0"
# CREDITS_PER_JOB="1"

# FREE TRIAL (legacy /api/process-audio path):
#   FREE_TRIAL_LIMIT=2        successful free trials per NORMAL user (0 = cap off)
#   PROVIDER_SPENDING_PROTECTION=true   Money-safety POSTURE only. This does NOT
#                                       stop transcription. Credit balance/reservation
#                                       checks, the free-trial count, the 2-minute
#                                       per-trial duration cap and the persisted
#                                       402/quota block are enforced on every request
#                                       regardless of this value.
#   PROVIDER_KILL_SWITCH=false           HARD operator kill-switch, SEPARATE from
#                                       spending protection. When true, NO provider
#                                       job is ever started for ANY caller while the
#                                       app is not yet generating revenue, or to stop
#                                       ASR spend immediately during a provider
#                                       incident. Set "true" to fully stop external
#                                       API spend without changing the posture above.
#   PROVIDER_QUOTA_COOLDOWN_MS=600000    quarantine cooldown after the provider
#                                       reports exhausted quota ("no credits
#                                       available"), so no further API jobs start
# # FREE_TRIAL_LIMIT="2"
# PROVIDER_SPENDING_PROTECTION="true"
# PROVIDER_KILL_SWITCH="false"
# PROVIDER_QUOTA_COOLDOWN_MS="600000"

# JOB QUEUE (local durable queue; long audio is processed off the request path):
#   ENABLE_JOB_QUEUE=true
#   JOB_TIMEOUT_MS=900000            15 min max wall-clock per job
#   MAX_JOB_RETRIES=1                auto-retries for transient failures
#   PER_USER_ACTIVE_JOBS=3           simultaneous QUEUED+PROCESSING per user
#   MAX_UPLOAD_BYTES=104857600       100 MB hard cap
#   UPLOAD_RATE_LIMIT_MAX=10         uploads allowed per window
#   UPLOAD_RATE_LIMIT_WINDOW_MS=3600000
# ENABLE_JOB_QUEUE="true"
# JOB_TIMEOUT_MS="900000"
# MAX_JOB_RETRIES="1"
# PER_USER_ACTIVE_JOBS="3"

# DATA_DIR: durable state (DB file + uploaded audio + SRTs). Gitignored.
# DATA_DIR="data"

# LOG_LEVEL: debug | info | warn | error (structured JSON lines)
# LOG_LEVEL="info"

# ADMIN_BOOTSTRAP_TOKEN: OPTIONAL operator-only secret (>= 16 chars). When a
# session is created with this value as `adminBootstrapToken` AND an
# `ownerEmail` that is present in OWNER_EMAILS, that user is granted
# role=ADMIN + creditMode=UNLIMITED (persisted in the DB, server-side).
# The role is NEVER read from the browser. Create your admin session with it,
# then remove this line from .env.
# ADMIN_BOOTSTRAP_TOKEN="change-me-to-a-long-random-string"

# OWNER EMAILS (admin/owner authorization, server-side only):
#   Comma-separated allowlist of the emails that may be granted role=ADMIN.
#   An ADMIN role alone is NOT enough: every admin request is re-checked against
#   this list AND against the owner email stored on the user record, so a role
#   that was granted some other way (or a revoked email) is rejected.
#   Combine with ADMIN_BOOTSTRAP_TOKEN in the "Owner" sign-in box of the UI, or
#   POST /api/session { "adminBootstrapToken": "...", "ownerEmail": "..." }.
OWNER_EMAILS="officeaipro6@gmail.com,sumitchinara@gmail.com"

# PROVIDER SAFETY (local state, persisted in the DB, survives restarts):
#   AVAILABLE  -> the provider is used normally
#   WARNING    -> transient/recent failures; the provider is still used
#   BLOCKED    -> the provider reported exhausted credits (HTTP 402 /
#                 insufficient_quota_error / explicit payment required). While
#                 blocked the app makes NO transcription calls, does NOT retry,
#                 does NOT auto-recharge and does NOT fall back to a paid
#                 provider. Only an authenticated owner can reset it to
#                 AVAILABLE from the admin panel after adding provider credits.
#   PROVIDER_WARNING_AFTER_FAILURES: consecutive transient failures needed to
#                                   move AVAILABLE -> WARNING (default 3).
# NOTE: no provider is known to expose a verified balance/quota API, so the UI
#       reports balance as "unknown" rather than inventing a percentage.
# PROVIDER_WARNING_AFTER_FAILURES="3"
